{
  "buildCommand": "node scripts/sync-notion.mjs && node scripts/generate-sitemap.mjs && node scripts/generate-feed.mjs && node scripts/generate-essay-pages.mjs && cp index.html writing.html",
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/feed.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/rss+xml; charset=utf-8"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/essay",
      "has": [
        {
          "type": "query",
          "key": "id",
          "value": "(?<id>[a-z0-9-]+)"
        }
      ],
      "destination": "/essays/:id",
      "permanent": true
    }
  ]
}
